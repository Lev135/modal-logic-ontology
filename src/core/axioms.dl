#pragma once
#include "../utils.dl"

// Formula in string representation
.type formula <: symbol
// Axiom name wrapped in ADT
.type Axiom = A { ax_name : symbol }
.type AxList = [head : Axiom, tail : AxList]
.type axListName <: symbol

.comp AxiomsComp {
  .decl dec(ax : Axiom)
  .output dec(filename="declared/$A.csv")

  .decl dec_list(axs : AxList)
  dec_list(axs) :- dec_list([_, axs]).
  .decl named_list(axs : AxList, name : axListName)
  dec_list(axs) :- named_list(axs, _).

  .decl ax_form(ax : Axiom, f : formula)
  dec(ax) :- ax_form(ax, _).
  errors("Axiom declared twice: " + n)
    :- ax_form(ax, f1), ax_form(ax, f2), f1 != f2, ax = $A(n).

  .decl alt(ax : Axiom, n : unsigned)
  .decl bd(ax : Axiom, n : unsigned)
  .decl bw(ax : Axiom, n : unsigned)
}

.init Axioms = AxiomsComp

.decl _ax_form(ax : symbol, f : formula)
.input _ax_form(filename="core/axiom_formula.csv", rfc4180=true, headers=true)
Axioms.ax_form($A(ax), f) :- _ax_form(ax, f).

Axioms.alt($A("Alt₁"), 1).
Axioms.alt($A("Alt₂"), 2).

Axioms.bd($A("Bd₁"), 1).
Axioms.bd($A("Bd₂"), 2).

Axioms.bw($A("Bw₁"), 1).
Axioms.bw($A("Bw₂"), 1).
