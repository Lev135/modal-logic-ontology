#pragma once

#include "./axioms.dl"

// Logic name wrapped in ADT
.type Logic = L { l_name : symbol }

.comp CongLogsComp {
  .decl dec(l : Logic)

  .decl ext(l : Logic, l0 : Logic, ax : Axiom)
  dec(l) :- ext(l, _, _).
  errors("Logic declared twice: " + l)
    :- ext($L(l), l01, ax1), ext($L(l), l02, ax2), (l01 != l02 ; ax1 != ax2).

  .decl ax_implies_over(l : Logic, ax1 : Axiom, ax2 : Axiom)

  .decl is(l : Logic)
  is(l) :- dec(l).
  .output is(filename="declared/$L.csv")

  .decl equiv(l1 : Logic, l2 : Logic)
  equiv(l1, l2) :- extends(l1, l2), extends(l2, l1).

  .decl extends(l1 : Logic, l2 : Logic)
  .decl proves(l : Logic, ax : Axiom)

  extends(l, l) :- is(l).
  extends(l1, l3) :- extends(l1, l2), extends(l2, l3).

  proves(l, ax) :- extends(l, l0), proves(l0, ax).
  proves(l, ax) :- ax_implies_over(l0, ax0, ax), extends(l, l0), proves(l, ax0).

  extends(l, l0), proves(l, ax) :- ext(l, l0, ax).
  extends(l1, l) :- ext(l, l0, ax), extends(l1, l0), proves(l1, ax).
}

.init CongLogs = CongLogsComp

.decl _ext(l : symbol, l0 : symbol, ax : symbol)
.input _ext(filename="core/cong_ext.csv", rfc4180=true, headers=true)
CongLogs.ext($L(l), $L(l0), $A(ax)) :- _ext(l, l0, ax).

.decl _proves(l : symbol, ax : symbol)
.input _proves(filename="core/proves.csv", rfc4180=true, headers=true)
CongLogs.proves($L(l), $A(ax)) :- _proves(l, ax).

.decl _ax_implies_over(l : symbol, ax1 : symbol, ax2 : symbol)
.input _ax_implies_over(filename="core/ax_implies_over.csv", rfc4180=true, headers=true)
CongLogs.ax_implies_over($L(l), $A(ax1), $A(ax2)) :- _ax_implies_over(l, ax1, ax2).

// Extra declarations

CongLogs.dec($L("E")).

CongLogs.proves($L("Fm"), ax) :- Axioms.is(ax).

CongLogs.ax_implies_over($L("E"), ax1, ax2)
  :- Axioms.is_alt(ax1, n1), Axioms.is_alt(ax2, n2), n1 < n2.

// Extra checks

warnings("Two logics are equal: " + n1 + ", " + n2)
  :- CongLogs.is(l1), CongLogs.is(l2),
    l1 != l2, CongLogs.equiv(l1, l2), l1=$L(n1), l2=$L(n2).

// Makinson's theorem: for every logic Λ ⊇ K one of the following holds:
//   - Λ ⊆ Triv
//   - Λ ⊆ Ver
//   - Λ |- ⊥
warnings("Unable to check Makinson's theorem for the logic " + n)
  :- CongLogs.is(l), CongLogs.extends(l, $L("K")),
      !CongLogs.extends($L("Triv"), l), !CongLogs.extends($L("Ver"), l),
      !CongLogs.proves(l, $A("Contr")),
      l = $L(n).
