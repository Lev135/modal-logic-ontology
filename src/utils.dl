#pragma once

.decl errors(what : symbol)
.output errors(IO=stdout)

.decl warnings(what : symbol)
.output warnings(IO=stdout)

.decl is_num(n : unsigned)
is_num(0). is_num(1). is_num(2).

.type InfUnsigned = Inf {} | Fin { num : unsigned }

.decl inf_less(n1 : InfUnsigned, n2 : InfUnsigned)
inf_less($Fin(n), $Inf()) :- is_num(n).
inf_less($Fin(n1), $Fin(n2)) :- n1 < n2, is_num(n1), is_num(n2).

// Unknown {} is used for properties which are stated somewhere as open problems
.type Bool3 = True {} | False {} | Unknown {}

// Abstract component for manager that tracks declarations
.comp Declarator<Name, Def> {
  // `kind_name(s)` = s is a human-readable name for the kind of objects.
  // Used in error message.
  //
  // Must be set exactly once after '.init'
  .decl kind_name(s : symbol)

  // `name_def(n, d)` = n is a name of object which is described by def
  .decl name_def(n : Name, d : Def)
  // `r_name(n)` = n is a name of some object
  //
  // READONLY. For writing use `name_def(n, d)`, specifying an object `d`
  // describing the definition of `n`.
  .decl r_name(n : Name)
  // `def(d)` = d is a definition of some object.
  // Useful for recursive data types to bound a variable.
  .decl def(d : Def)

  r_name(n) :- name_def(n, _).
  def(x) :- name_def(_, x).

  // `r_def_kind_name(s) <=> kind_name(s)` or no `kind_name` was defined and
  // `s = Unknown`. Should be used for error messages.
  .decl r_def_kind_name(s : symbol)
  r_def_kind_name(s) :- kind_name(s); !kind_name(_), s = "Unknown".

  errors(kn + " with name '" + n + "' was declared twice")
    :- r_def_kind_name(kn), name_def(n, x1), name_def(n, x2), x1 != x2.

  warnings("Declarator has no kind_name") :- !kind_name(_).
}

.comp ListsComp<T> : Declarator<name, Ty> {
  .type Ty = [head : T, tail : Ty]
  .type name <: symbol

  def(xs) :- def([_, xs]).

  .decl member(x : T, xs : Ty)
  member(x, [x1, xs1]) :- def([x1, xs1]), (x = x1; member(x, xs1)).
}

.type Void = _Void {}
