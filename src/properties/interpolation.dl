#pragma once
#include "../core/cong_logics.dl"

.comp InterpolationComp {
  .decl CIP(l : logic, b : Bool3)
  .decl LIP(l : logic, b : Bool3)

  CIP(l, $True()) :- LIP(l, $True()).
  LIP(l, $False()) :- CIP(l, $False()).
}
.init Interpolation = InterpolationComp

Interpolation.CIP(@logic("K4.3"), $False()).
Interpolation.LIP(@logic("K"), $True()).
