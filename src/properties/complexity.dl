#pragma once
#include "../core/cong_logics.dl"
#include "./approximation.dl"

.type CompC = P {} | NP {} | coNP {} | PSpace {} | ExpTime {} | ExpSpace {} | Decidable {}

.comp ComplexityComp<T> {
  .decl less(cc1 : CompC, cc2 : CompC)
  less($P(), $NP()).
  less($P(), $coNP()).
  less($NP(), $PSpace()).
  less($coNP(), $PSpace()).
  less($PSpace(), $ExpTime()).
  less($ExpTime(), $ExpSpace()).
  less($ExpSpace(), $Decidable()).
  less(cc1, cc3) :- less(cc1, cc2), less(cc2, cc3).

  .decl simpler(t1 : T, t2 : T)

  .decl in(t : T, cc : CompC)
  in(t, cc2) :- in(t, cc1), less(cc1, cc2).
  in(t1, cc) :- in(t2, cc), simpler(t1, t2).

  .decl hard(t : T, cc : CompC)
  hard(t, cc1) :- hard(t, cc2), less(cc1, cc2).
  hard(t2, cc) :- hard(t1, cc), simpler(t1, t2).

  .decl r_complete(t : T, cc : CompC)
  r_complete(t, cc) :- in(t, cc), hard(t, cc).

  .decl decidable(t : T)
  decidable(t) :- in(t, $Decidable()).
  in(t, $Decidable()) :- decidable(t).
}

.type Task = SAT { l : logic, vars : InfUnsigned }

.init Complexity = ComplexityComp<Task>

Complexity.simpler($SAT(l, n1), $SAT(l, n2)) :- CongLogs.dec(l), inf_less(n1, n2).

// Every logic with infinitely many variables is coNP-hard
Complexity.hard($SAT(l, $Inf()), $coNP()) :- CongLogs.dec(l).

// Harrop's theorem
Complexity.decidable($SAT(l, $Inf())) :- Approximation.fmp(l), CongLogs.r_fin_axiomaizable(l).

// Lower bounds

// https://doi.org/10.1093/jigpal/jzy018
Complexity.hard($SAT(l, $Fin(1)), $PSpace())
  :- CongLogs.r_between(@logic("KTB"), l, @logic("K")).
// http://www.aiml.net/volumes/volume4/Chagrov-Rybakov.ps Theorem 3
Complexity.hard($SAT(l, $Fin(0)), $PSpace())
  :- CongLogs.r_between(@logic("K4"), l, @logic("K")).
// http://www.aiml.net/volumes/volume4/Chagrov-Rybakov.ps Theorem 8
Complexity.hard($SAT(l, $Fin(1)), $PSpace())
  :- CongLogs.r_between(@logic("GL"), l, @logic("K")) ; CongLogs.r_between(@logic("Grz"), l, @logic("K")).
// http://www.aiml.net/volumes/volume4/Chagrov-Rybakov.ps Theorem 10
Complexity.hard($SAT(@logic("GL.3"), $Fin(1)), $NP()).
// http://www.aiml.net/volumes/volume4/Chagrov-Rybakov.ps Theorem 12
Complexity.hard($SAT(l, $Fin(1)), $coNP())
  :- l = @logic("S4.3") ; l = @logic("Grz.3").
// https://arxiv.org/pdf/2507.12343 Theorem 1
Complexity.hard($SAT(l, $Fin(2)), $PSpace())
  :- CongLogs.r_between(@logic("Grz.2"), l, @logic("K")).
// https://arxiv.org/pdf/2507.12343 Theorem 2
Complexity.hard($SAT(l, $Fin(1)), $PSpace())
  :- CongLogs.r_between(@logic("GL.2"), l, @logic("K")).



// Complexity.hard($SAT(@logic("EC"), $Inf()), $PSpace()).

// Upper bounds

// http://www.aiml.net/volumes/volume4/Chagrov-Rybakov.ps Theorem 9 (known before?)
Complexity.in($SAT(@logic("GL"), $Fin(0)), $P()).
// http://www.aiml.net/volumes/volume4/Chagrov-Rybakov.ps Theorem 11
Complexity.in($SAT(l, $Fin(1)), $P())
  :- l = @logic("S4.3") ; l = @logic("Grz.3").
// Every polynomially approximable logic is coNP-decidable TODO: reference???
Complexity.in($SAT(l, $Inf()), $coNP()) :- Approximation.approximable(l, $Polynomial()).

// This result follows from my unpublished material. Of course, for some logics,
// like K, K4, S4, etc. we could provide references, but I don't know about others
// TODO: add appropriate citations
AxLists.name_def("TDB", [@axiom("T"), [@axiom("D"), [@axiom("B"), nil]]]).
Complexity.in($SAT(l, $Inf()), $PSpace())
  :- CongLogs.r_extension_by_some_of(l, @logic("K"), "TDB").
AxLists.name_def("TD.1.2", [@axiom("T"), [@axiom("D"), [@axiom(".1"), [@axiom(".2"), nil]]]]).
Complexity.in($SAT(l, $Inf()), $PSpace())
  :- CongLogs.r_extension_by_some_of(l, @logic("K4"), "TD.1.2").
Complexity.in($SAT(@logic("wK4"), $Inf()), $PSpace()).
Complexity.in($SAT(l, $Inf()), $PSpace())
  :- l = @logic("GL"); l = @logic("Grz"); l = @logic("GL.2"); l = @logic("Grz.2").

// Complexity.in($SAT(l, $Inf()), $coNP()) :- l = @logic("EM"); l = @logic("EMD"); l = @logic("E"); l = @logic("EMP").
// Complexity.in($SAT(l, $Inf()), $PSpace()) :- l = @logic("K"); l = @logic("KD"); l = @logic("GL").
